# Text is stored and checked out with LF on every platform: the build compares bytes, and a
# notebook with CRLF line endings does not open in every tool.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.pdf binary
*.woff2 binary
*.xlsx binary
*.docx binary
*.pptx binary
*.parquet binary

# The synthetic logs keep their bytes: one station writes CR LF on purpose (lab 1.2)
labs/kit/data/** -text
